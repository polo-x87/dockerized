# Copy to base/.env and fill in.
# base/.env is gitignored.

# Your dotfiles repo. Leave blank to use the bundled dotfiles-sample.
DOTFILES_REPO=

# Where your code lives on the Mac (will be bind-mounted into /home/dev/code)
DEVBOX_HOST_CODE_DIR=${HOME}/code

# Where your vault lives on the Mac (bind-mounted into /home/dev/vault)
DEVBOX_HOST_VAULT_DIR=${HOME}/vault

# Public key whose private counterpart you use to ssh into devbox
DEVBOX_HOST_SSH_PUBKEY=${HOME}/.ssh/devbox_ed25519.pub

# Optional: API keys. Prefer `op run -- <cmd>` at runtime over committing these here.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
